    <!-- honest notes under AudioLab controls whose engine does not exist in ChordWave -->
    <string name="audiolab_no_engine_reverb">ChordWave has no reverb engine yet.</string>
    <string name="audiolab_no_engine_loudness">ChordWave has no loudness boost or compressor yet — “Even out songs” below still works.</string>
    <string name="audiolab_no_engine_spatial_params">ChordWave’s spatial audio is a fixed stereo widener — no adjustments yet.</string>
    <string name="audiolab_no_engine_mono">ChordWave has no mono mix yet.</string>
    <string name="audiolab_no_engine_atmos">ChordWave has no surround renderer yet, so Atmos and 5.1/7.1 play as stereo.</string>
    <string name="audiolab_no_engine_volume">ChordWave has no volume curve yet — the player’s own volume still works.</string>
    <string name="audiolab_no_engine_resampler">ChordWave has no Hi-fi resampler yet.</string>

