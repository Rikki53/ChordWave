    <string name="audiopass_passthrough">Bit-perfect passthrough</string>
    <string name="audiopass_passthrough_desc">Songs reach the DAC as they are, without Android mixing or resampling them.</string>
    <string name="audiopass_modes">Modes</string>
    <string name="audiopass_mode_direct_usb">Direct USB</string>
    <string name="audiopass_mode_direct_usb_desc">ChordWave drives the DAC itself on any Android and sets the volume on the DAC. Asks for USB access.</string>
    <string name="audiopass_mode_bit_perfect">Bit-perfect</string>
    <string name="audiopass_mode_bit_perfect_desc">Android hands every lossless song to the DAC untouched.</string>
    <string name="audiopass_mode_exclusive_dac">Built-in DAC</string>
    <string name="audiopass_mode_exclusive_dac_desc">For music players with their own DAC: the headphone jack opens just for ChordWave.</string>
    <string name="audiopass_mode_needs">Needs Android %1$s</string>

