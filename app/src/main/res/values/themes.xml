<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all theming; this just gives an edge-to-edge, action-bar-free window. -->
    <style name="Theme.ChordWave" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- the launch splash (batch 38, icon restored in batch 46): the mint
         ribbon of the launcher icon on black, the look the splash had
         before batch 38, handed off to the in-app launch intro that
         flies it into Home's logo. Batch 38 pointed this at
         ic_chordwave_mark, which is the white in-app mark, so the splash
         showed a big white ribbon instead of the mint one. -->
    <style name="Theme.ChordWave.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ChordWave</item>
    </style>
</resources>
