<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all theming; this just gives an edge-to-edge, action-bar-free window. -->
    <style name="Theme.ChordWave" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- the launch splash (batch 38): the mint ribbon on black, handed off
         to the in-app launch intro that flies it into Home's logo -->
    <style name="Theme.ChordWave.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_chordwave_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.ChordWave</item>
    </style>
</resources>
