<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <!-- Material play_arrow triangle morphing into pause bars (feedback 24 Nov: replaces the Mochy rounded-stroke morph) -->
    <aapt:attr name="android:drawable">
        <vector android:width="32dp" android:height="32dp" android:viewportWidth="24" android:viewportHeight="24">
            <group android:pivotX="12" android:pivotY="12" android:name="scale_group">
                <path
                    android:name="path_left"
                    android:pathData="M8,5 L8,19 L13.5,15.5 L13.5,8.5 Z"
                    android:fillColor="#ffffff" />
                <path
                    android:name="path_right"
                    android:pathData="M13.5,8.5 L13.5,15.5 L19,12 L19,12 Z"
                    android:fillColor="#ffffff" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="path_left">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="pathData"
                android:valueFrom="M8,5 L8,19 L13.5,15.5 L13.5,8.5 Z"
                android:valueTo="M6,5 L10,5 L10,19 L6,19 Z"
                android:valueType="pathType"
                android:duration="400"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="path_right">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="pathData"
                android:valueFrom="M13.5,8.5 L13.5,15.5 L19,12 L19,12 Z"
                android:valueTo="M14,5 L18,5 L18,19 L14,19 Z"
                android:valueType="pathType"
                android:duration="400"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
</animated-vector>
